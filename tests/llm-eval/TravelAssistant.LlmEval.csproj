<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- LLM evals are nightly only. Don't include in the default test run. -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\llm-eval.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <PackageReference Include="YamlDotNet" Version="16.1.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <None Update="goldens\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    SEC-2b corpus link. Conditional so this project builds on QA branches even
    before security/sec-2b-prompt-injection-corpus merges to main. Once SEC-2b
    lands, the file is auto-discovered and CorpusEchoTests activates.
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\TravelAssistant.Security.Tests\PromptInjection\Corpus\injection-corpus.yaml')">
    <None Include="..\TravelAssistant.Security.Tests\PromptInjection\Corpus\injection-corpus.yaml"
          Link="corpus\injection-corpus.yaml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Shared CorpusLoader (SEC-2b). Source-include rather than ProjectReference so
    this project stays unblocked on QA branches before the Security.Tests csproj
    exists. Conditional: links only when the file is present on disk, and
    defines HAS_SHARED_CORPUS_LOADER so CorpusEchoTests can switch contracts
    safely (private DTOs when absent, shared types when present).
    Owner of contract: security-hardening-squad. Do NOT duplicate the DTOs here.
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\TravelAssistant.Security.Tests\PromptInjection\CorpusLoader.cs')">
    <Compile Include="..\TravelAssistant.Security.Tests\PromptInjection\CorpusLoader.cs"
             Link="Shared\CorpusLoader.cs" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\..\TravelAssistant.Security.Tests\PromptInjection\CorpusLoader.cs')">
    <DefineConstants>$(DefineConstants);HAS_SHARED_CORPUS_LOADER</DefineConstants>
    <!--
      Suppress CA1062 (validate public method args for null) on the linked
      CorpusLoader. The loader is owned by security-hardening-squad and its
      public API treats null as a programmer error. Filed upstream: ping
      security to add ArgumentNullException.ThrowIfNull in v1.1 of the loader.
      Scoped to this project only — does not weaken QA's own code analysis.
    -->
    <NoWarn>$(NoWarn);CA1062</NoWarn>
  </PropertyGroup>

</Project>
